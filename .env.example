# Optional model interface for the LOCAL MCP generate tool.
# The default host-Agent specification path does not need these variables.
# Set these in the process/client environment. Keep the real key local.
# Do not put a key in this file, a project JSON, an MCP tool argument, or Git.
# The static Web app uses its own session-only form, not this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=12000
